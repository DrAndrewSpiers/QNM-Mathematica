Cell[CellGroupData[{
Cell["QNM", "GuideTitle",
 CellID->337373074,ExpressionUUID->"bba22d4f-f454-434d-8f8a-a49fdaf8401c"],

Cell[TextData[{
 "Functions for computing quasinormal modes of the Teukolsky equation in \
Schwarzschild and Kerr spacetimes, and of the coupled gravito-electromagnetic \
perturbations of Kerr-Newman black holes using the separated equations of ",
 ButtonBox["P. Hintz, \"Perturbations of Kerr-Newman black holes: separation \
and mode stability\", arXiv:2609.33661 (2026)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2609.33661"], None},
  ButtonNote->"https://arxiv.org/abs/2609.33661"],
 "."
}], "GuideAbstract",
 CellChangeTimes->{{3.942131175354856*^9, 3.9421311885396013`*^9}},
 CellID->872426638,ExpressionUUID->"5cad4689-9500-4068-b3de-d64088e3c845"]
}, Open  ]],

