Cell["\<\
Give an initial guess and search for the root directly, without continuation \
from the Kerr mode:\
\>", "ExampleText",
 CellID->251958368,ExpressionUUID->"16c11c92-ae43-4b92-b897-0a9bcc648b2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QNMFrequencyKN", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "0", ",", "0.6`", ",", "0.5`",
    ",", 
   RowBox[{"Method", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<HintzSeparated\>\"", ",", 
      RowBox[{"\"\<InitialGuess\>\"", "\[Rule]", 
       RowBox[{"0.53`", "\[VeryThinSpace]", "-", 
        RowBox[{"0.08`", " ", "\[ImaginaryI]"}]}]}]}], "}"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1697397693,ExpressionUUID->"a266c8a7-52af-4deb-96b4-3f8dbac49d62"],

Cell[BoxData[
 RowBox[{"0.5361271297184547`", "\[VeryThinSpace]", "-", 
  RowBox[{"0.08117837201516796`", " ", "\[ImaginaryI]"}]}]], "Output",
 CellLabel->"Out[1]=",
 CellID->1405974903,ExpressionUUID->"5b2e4962-b1ad-4eb1-8551-4ef5f3197fcd"]
}, Open  ]],

