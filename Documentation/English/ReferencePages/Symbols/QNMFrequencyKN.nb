Cell["\<\
Scalar perturbations are not covered by Hintz's separated system:\
\>", "ExampleText",
 CellID->1082934737,ExpressionUUID->"57b5cda7-52c7-4eae-8097-535c50e63cc7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QNMFrequencyKN", "[", 
  RowBox[{"0", ",", "2", ",", "2", ",", "0", ",", "0.6`", ",", "0.5`"}], 
  "]"}]], "Input",
