Notebook[{

Cell[CellGroupData[{
Cell["QNMFrequencyKN", "ObjectName",
 CellID->232457451,ExpressionUUID->"773c7591-2c2e-4cb1-9d28-9d738fb5fd51"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f931b675-5da0-4945-93c7-b5d0899aa4e2"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["QNMFrequencyKN",
    BaseStyle->"Link",
    ButtonData->"paclet:QNM/ref/QNMFrequencyKN"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["l", "TI"], ",", 
    StyleBox["m", "TI"], ",", 
    StyleBox["n", "TI"], ",", 
    StyleBox["a", "TI"], ",", 
    StyleBox["Q", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "2280fabe-8e6f-47bc-946a-a1c1057fea52"],
 "\[LineSeparator]computes a quasinormal mode frequency of a Kerr-Newman \
black hole with spin a and charge Q."
}], "Usage",
 CellID->1687809277,ExpressionUUID->"93b74c6b-9f7c-4c52-b6d1-4e4ab104224b"],

Cell["\<\
Mathematical function, suitable for both symbolic and numerical manipulation.\
\
\>", "Notes",
 CellID->1431218569,ExpressionUUID->"00e91974-c153-4659-b636-3136a47c86f1"],

Cell[TextData[{
 "The frequency is that of a quasinormal mode of the coupled gravitational \
and electromagnetic perturbations of a Kerr-Newman black hole of mass ",
 Cell[BoxData[
  RowBox[{"M", "=", "1"}]], "InlineFormula",ExpressionUUID->
  "b5654c9e-857b-4b7f-ad45-a9e55149fc5b"],
 ", spin ",
 Cell[BoxData[
 "a"], "InlineFormula",ExpressionUUID->"35486ef9-63fe-42c2-a649-240a6b74b0e4"],
 " and charge ",
 Cell[BoxData[
 "Q"], "InlineFormula",ExpressionUUID->"47d9fb05-ed07-415b-b32a-52a487e86239"],
 " (in units of ",
 Cell[BoxData[
 "M"], "InlineFormula",ExpressionUUID->"c3ac6f95-b79f-4244-93b7-3f394b264d8d"],
 "), with ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox["a", "2"], "+", 
    SuperscriptBox["Q", "2"]}], "<", "1"}]], "InlineFormula",ExpressionUUID->
  "68198f66-8279-48f4-a8c2-01199e45dee4"],
 ". Modes have time and azimuthal dependence ",
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "(", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "m", " ", "\[Phi]"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "t", " ", "\[Omega]"}]}], ")"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8b95c815-f638-40b6-8224-b1f67d34c268"],
 "."
}], "Notes",
 CellID->1847158989,ExpressionUUID->"e13211d4-4cc4-486a-bdc3-3af274f5867a"],

Cell[TextData[{
 "The frequencies are computed from the separation of the linearised \
Einstein-Maxwell equations found by ",
 ButtonBox["P. Hintz, \"Perturbations of Kerr-Newman black holes: separation \
and mode stability\", arXiv:2609.33661 (2026)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2609.33661"], None},
  ButtonNote->"https://arxiv.org/abs/2609.33661"],
 ": an angular eigenvalue problem for the separation constant ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ecdacfec-a7e0-44a2-ba11-bab0658dc622"],
 " and a first-order radial system for two functions ",
 Cell[BoxData[
  FormBox["w", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6a875a0e-fc22-4c96-a57b-d8a080ac051e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "\"\<\[Sharp]\>\""], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"aa12df22-778f-41bd-be00-45a90bb7d55c"],
 " (see ",
 Cell[BoxData[
  ButtonBox["QNMRadialKN",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMRadialKN"]], "InlineFormula",ExpressionUUID->
  "f4207e8e-4e83-4cfe-9d85-b63929cca257"],
 "). A quasinormal mode is a frequency for which the radial solution is \
smooth at the outer horizon ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "\"\<+\>\""], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7d43daa3-51b7-4086-941f-1e0cf3a42269"],
 " and outgoing at infinity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "\[Tilde]", 
    RowBox[{
     SuperscriptBox["r", 
      RowBox[{"4", " ", "\[ImaginaryI]", " ", "\[Omega]"}]], " ", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "k", " ", "r"}], ")"}]}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "54f0a861-05bd-473c-867d-d995e4069a4f"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[LongEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", 
       SuperscriptBox["Q", "2"], " ", "\[Omega]"}], 
      RowBox[{"1", "-", 
       SuperscriptBox["Q", "2"]}]], "+", 
     RowBox[{"2", " ", "\[Omega]"}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"2f43ac33-9028-49db-9656-bf0f7933166e"],
 "."
}], "Notes",
 CellID->1384378292,ExpressionUUID->"e14311b9-f085-4714-be5c-f52bc0c38fe3"],

Cell[TextData[{
 "The spin weight selects the family of modes: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Abs", "[", "s", "]"}], "\[Equal]", "2"}]], "InlineFormula",
  ExpressionUUID->"0da6c0c4-7429-460a-8b6e-a09be599f4ce"],
 " gives the gravitational-led mode and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"Abs", "[", "s", "]"}], "\[Equal]", "1"}]], "InlineFormula",
  ExpressionUUID->"4d06a65d-666c-42ec-99cb-89b477fa99ec"],
 " the electromagnetic-led mode, which reduce to the Kerr modes ",
 Cell[BoxData[
  ButtonBox["QNMFrequency",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequency"]], "InlineFormula",
  ExpressionUUID->"5235bf57-1f26-44c8-be7e-bb95f1c28787"],
 "[",
 Cell[BoxData[
  RowBox[{"-", "2"}]], "InlineFormula",ExpressionUUID->
  "40d93974-f28c-41bf-b4e0-d39d4d2bbc86"],
 ", l, m, n, a] and ",
 Cell[BoxData[
  ButtonBox["QNMFrequency",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequency"]], "InlineFormula",
  ExpressionUUID->"2f23e5a0-8e27-4fb0-ba8c-c02e5346c6a8"],
 "[",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineFormula",ExpressionUUID->
  "7dfc6353-cd5a-4a27-9090-a7dc71a2ec2d"],
 ", l, m, n, a] as ",
 Cell[BoxData[
  RowBox[{"Q", "\[Rule]", "0"}]], "InlineFormula",ExpressionUUID->
  "30393654-7dbb-4eea-80ce-5e3a6bc4a05f"],
 ". The sign of ",
 Cell[BoxData[
 "s"], "InlineFormula",ExpressionUUID->"9db4fa62-f089-483d-9791-3f8f1df1e912"],
 " does not affect the frequency. ",
 Cell[BoxData[
  RowBox[{"l", "\[GreaterEqual]", 
   RowBox[{"Abs", "[", "s", "]"}]}]], "InlineFormula",ExpressionUUID->
  "05f4c01d-336d-49a9-8e61-e3f1f9703f37"],
 ", so the dipole ",
 Cell[BoxData[
  RowBox[{"l", "=", "1"}]], "InlineFormula",ExpressionUUID->
  "f9200d5f-0661-42cd-8500-60b9b051c998"],
 " exists only for the electromagnetic-led family. Scalar perturbations (",
 Cell[BoxData[
  RowBox[{"s", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "2c1d1ce9-0834-480a-89bb-88475a35a528"],
 ") are not covered by Hintz's system."
}], "Notes",
 CellID->157501012,ExpressionUUID->"eed39a2a-e449-471b-921c-f78f15ad3291"],

Cell[TextData[{
 "The mode labels ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"l", ",", "m", ",", "n"}], "}"}]], "InlineFormula",ExpressionUUID->
  "79e03994-ae3c-4e34-8ca7-5a615ede7278"],
 " are those of the Kerr mode to which the mode reduces as ",
 Cell[BoxData[
  RowBox[{"Q", "\[Rule]", "0"}]], "InlineFormula",ExpressionUUID->
  "00cd4983-f27f-4b34-871d-b71bb2a74d2c"],
 ". The frequency is computed by continuation in the charge at fixed spin, \
starting from the Kerr frequency computed with ",
 Cell[BoxData[
  ButtonBox["QNMFrequency",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequency"]], "InlineFormula",
  ExpressionUUID->"db272a1e-a926-4cbb-80dc-c62ec22c38d9"],
 ". The separation constant is labelled by continuity in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " ", "\[Omega]"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"7f9e01f1-1313-49bf-b2b9-26ea49f549d0"],
 " from ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", " ", "\[Omega]"}], "\[LongEqual]", "0"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b3c2c591-bb3b-4d2f-94f2-ce43c572bfce"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", 
     SqrtBox[
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"l", "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"l", "+", "2"}], ")"}]}], "+", 
       FractionBox["9", 
        RowBox[{"4", " ", 
         SuperscriptBox["Q", "2"]}]]}]]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"d1ff5012-7da2-41bd-ae9d-3369482172fa"],
 " (",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox["3", 
      RowBox[{"2", " ", "Q"}]]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"858d2eb0-0c78-4bfe-9cf7-eaaf5468d211"],
 " for ",
 Cell[BoxData[
  RowBox[{"l", "=", "1"}]], "InlineFormula",ExpressionUUID->
  "7c36810f-ec10-41f0-bcab-d231f07db221"],
 ")."
}], "Notes",
 CellID->890109631,ExpressionUUID->"d785a351-c944-4c6c-8a05-67eb785278dd"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  RowBox[{"Q", "=", "0"}]], "InlineFormula",ExpressionUUID->
  "679cfdfb-dd53-4905-ad02-677a35f56fd6"],
 ", QNMFrequencyKN returns ",
 Cell[BoxData[
  ButtonBox["QNMFrequency",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequency"]], "InlineFormula",
  ExpressionUUID->"c3319c4f-7e2e-422c-b36d-9844e1d34edf"],
 "[",
 Cell[BoxData[
  RowBox[{"-", 
   RowBox[{"Abs", "[", "s", "]"}]}]], "InlineFormula",ExpressionUUID->
  "2b88a9d3-7309-4765-a05b-f2a6ae114597"],
 ", l, m, n, a]. The spectrum is invariant under ",
 Cell[BoxData[
  RowBox[{"Q", "\[Rule]", 
   RowBox[{"-", "Q"}]}]], "InlineFormula",ExpressionUUID->
  "57861952-4860-40d0-a5cd-4ba90cc20fe3"],
 " and under ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "m"}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "m"}]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "850d3c70-bb75-442f-8736-b7bbf529712f"],
 "."
}], "Notes",
 CellID->769740365,ExpressionUUID->"89caf599-d72c-40de-a1bb-3bec63b33cd8"],

Cell[TextData[{
 "Hintz's equations come in two versions, the positive and negative spin \
systems ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"c8cd3b26-81ca-4040-8a75-5c0ed8ddb28e"],
 " (built from the Weyl scalars ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e2fcf098-5683-4fa2-8728-d938d95ddb1f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "1"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"00a436a7-f03a-4316-9a72-8ac1be06f766"],
 " or ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "4"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"172a07ec-367f-4c29-98da-4717214f7b7f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "3"], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9247b70b-f1cd-4328-ae5b-6230a5cedd7a"],
 "). They give the same frequencies; ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", "\[LongEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"48cdf122-177f-4552-9165-64fd34407a88"],
 " is used by default."
}], "Notes",
 CellID->1823515429,ExpressionUUID->"33fb8089-993e-46db-a886-b2959d8e5903"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["QNMFrequencyKN",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequencyKN"]], "InlineFormula",
  ExpressionUUID->"2201b1ee-dfab-48f3-a1b0-75d675c50cd2"],
 " can be evaluated to arbitrary numerical precision. For numerical values of \
",
 Cell[BoxData[
 "a"], "InlineFormula",ExpressionUUID->"01a20c72-960a-4581-8124-1f98730ecfa1"],
 " and ",
 Cell[BoxData[
 "Q"], "InlineFormula",ExpressionUUID->"a4c10593-694c-4817-b686-1c1992bee54d"],
 ", the result has the precision of the less precise of the two. With \
machine-precision input the result is typically accurate to about ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox["10", "14"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"64a3f4a2-bd4e-494e-b6bd-6e2c11d17c68"],
 " away from extremality (less for high overtones)."
}], "Notes",
 CellID->1173846428,ExpressionUUID->"1def5f23-adbd-4597-b01c-f42fc4acdd6b"],

Cell["The following options can be given: ", "Notes",
 CellID->1089839419,ExpressionUUID->"6a46dff5-f324-4acb-9cc1-dd89799c9f6b"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "7caaa5d7-8bd2-4e76-a556-5485f63b16ae"], 
    ButtonBox["Method",
     BaseStyle->"Link"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
Method to use. The only method is \"HintzSeparated\" (the default).\
\>", "TableText",ExpressionUUID->"447fb784-64a1-41ec-8864-274d7a54701b"]}
  }]], "3ColumnTableMod",
 CellID->1501293933,ExpressionUUID->"3f0a8c9d-aee0-418d-8ac1-5d9722bba780"],

Cell[TextData[{
 "Suboptions can be given with ",
 Cell[BoxData[
  RowBox[{"Method", "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"\"\<HintzSeparated\>\"", ",", "opts"}], "}"}]}]], 
  "InlineFormula",ExpressionUUID->"01c7a3cb-4a8c-40b3-9700-af783db14141"],
 ". The possible suboptions are:"
}], "Notes",
 CellID->287567597,ExpressionUUID->"fd7d710e-2176-4c49-b528-d7c6c476d349"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c16216dc-2b5b-41e7-86cc-8e715c8069b8"], "\"\<InitialGuess\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
initial guess for the frequency; if given, the root is searched for directly, \
without continuation from the Kerr mode\
\>", "TableText",ExpressionUUID->"01c2a76c-c3b4-4b18-89bd-15c54632abd2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "f02e915a-ed80-4612-abbf-639f85850620"], "\"\<KerrFrequency\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
frequency of the Kerr mode at which the continuation in Q starts; by default \
from QNMFrequency\
\>", "TableText",ExpressionUUID->"1e224e2b-d966-46b2-849a-5928410a12af"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d3dba728-785d-463f-8d40-9ec484facb63"], "\"\<SeriesOrder\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
number of terms of the series about the horizon; Automatic adds terms until \
it has converged\
\>", "TableText",ExpressionUUID->"fd37c515-5a20-4a0d-bfea-9daacbf1e443"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "bb46b1d3-dbde-46af-9f33-120a9b41890c"], "\"\<MatchingRadius\>\"", "6", 
    Cell["\<\
radius at which the horizon and outgoing solutions are compared\
\>", "TableText",ExpressionUUID->"c7ff6f5e-62ea-429d-8d8e-6bf350efbb93"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "9763f068-96c0-4959-912a-131ffa295704"], "\"\<RayLength\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
length of the complex ray along which the outgoing solution is integrated\
\>", "TableText",ExpressionUUID->"ee399cfd-4dab-4911-a4d1-c33580b3adf2"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "0f46b94a-4438-4445-9ae7-ddde223d7861"], "\"\<AngularTruncation\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
largest l of the spin-weighted harmonics used for the angular problem\
\>", "TableText",ExpressionUUID->"a65f6110-626d-4ae9-a571-d21055d06673"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d81b36e3-ff86-4cdd-a92b-a3704f1c1143"], "\"\<SpinSystem\>\"", "1", Cell[
    "Hintz's spin system, 1 or -1", "TableText",ExpressionUUID->
     "1e866f77-90d8-489a-b370-dc0f75206892"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "aaf8cede-5664-4984-a9de-ea542f885372"], "\"\<AccuracyCheck\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
whether to estimate the accuracy (Automatic: near extremality only)\
\>", "TableText",ExpressionUUID->"ba153e6d-b798-435c-b4ac-00d9cade542d"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "2d2ac8f3-afe9-4b76-9b38-d3679a806511"], 
    ButtonBox["WorkingPrecision",
     BaseStyle->"Link"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
precision of the final root search (Automatic: the precision of a and Q)\
\>", "TableText",ExpressionUUID->"931e8848-cbe7-454f-85b5-a68b3fd2def9"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b3691e8f-1b6d-401b-a112-997531e9374a"], 
    ButtonBox["PrecisionGoal",
     BaseStyle->"Link"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
precision goal of the numerical integration of the radial system\
\>", "TableText",ExpressionUUID->"551e5867-e53b-49e6-9cd2-b5f253b1b7cd"]}
  }]], "3ColumnTableMod",
 CellID->1081611517,ExpressionUUID->"9582a367-4ea5-4444-b6b2-03e6fffe8db6"],

Cell[TextData[{
 "The radial system is solved with a Frobenius series at the horizon, \
integrated along the real axis to the matching radius, and with the outgoing \
solution integrated inward along a ray in the complex ",
 Cell[BoxData[
 "r"], "InlineFormula",ExpressionUUID->"c7f04d73-bc8c-4eba-b74b-c70560d21862"],
 " plane, on which it is not subdominant. The angular eigenvalue is computed \
with a spectral method in spin-weighted spherical harmonics. The numerical \
method follows A. Spiers, \"Quasinormal modes from Hintz's separated \
Kerr-Newman equations: Reissner-Nordstr\[ODoubleDot]m tests and rotating \
black holes\" (2026)."
}], "Notes",
 CellID->590504701,ExpressionUUID->"30eb8837-f49b-4efe-ac0e-7adfec515f69"],

Cell[TextData[{
 "Near extremality (",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox["a", "2"], "+", 
    SuperscriptBox["Q", "2"]}], "\[Rule]", "1"}]], "InlineFormula",
  ExpressionUUID->"cdc9c4da-59a3-4755-a055-760ddd956dd8"],
 ") the radial system becomes badly conditioned. Close to ",
 Cell[BoxData[
  RowBox[{"Q", "=", "1"}]], "InlineFormula",ExpressionUUID->
  "0fe5047d-03e7-4434-999e-423df93fb064"],
 " machine-precision results are less accurate, and a message is given when \
the estimated error is larger than ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox["10", "9"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0c2323f9-226c-4af6-bd0e-433a9bcfb6e8"],
 " relative. Higher accuracy is obtained with higher-precision input."
}], "Notes",
 CellID->222806130,ExpressionUUID->"9928cc42-9753-47d6-8d5d-47cf0e594076"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "See Also",
 Cell[BoxData[
  TemplateBox[{"SeeAlso", 
    Cell[
     BoxData[
      FrameBox[
       Cell[
       "Insert links to any related reference (function) pages.", 
        "MoreInfoText"], BaseStyle -> "IFrameBox"]], "MoreInfoTextOuter"]},
   "MoreInfoOpenerButtonTemplate"]],ExpressionUUID->
  "3855573d-afc4-4e2c-ad16-db93694797c3"]
}], "SeeAlsoSection",
 CellID->2001075377,ExpressionUUID->"699d7c0b-a818-4e57-b271-2e90c9a2f9bf"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["QNMFrequency",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequency"]], "InlineSeeAlsoFunction",
