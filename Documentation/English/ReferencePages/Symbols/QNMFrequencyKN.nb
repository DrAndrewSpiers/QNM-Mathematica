Cell[TextData[{
 "The frequency does not depend on the sign of ",
 Cell[BoxData[
 "s"], "InlineFormula",ExpressionUUID->"a12d0c96-655a-4892-8ddd-97634ccef11d"],
 " or of ",
 Cell[BoxData[
 "Q"], "InlineFormula",ExpressionUUID->"acb4825f-df85-4bdd-a389-a0016dffa536"],
 ", and ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", ",", "m"}], "}"}], "\[Rule]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "m"}]}], "}"}]}]], "InlineFormula",ExpressionUUID->
  "ef950a68-367b-443b-be55-e9fffa44b8ce"],
 " is a symmetry:"
}], "ExampleText",
 CellID->1904267642,ExpressionUUID->"e056181d-2693-4ca5-b064-c28c71a1d4c3"],

