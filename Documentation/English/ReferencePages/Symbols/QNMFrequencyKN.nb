 CellID->2036177271,ExpressionUUID->"75e4ee87-a5be-4b8b-b07d-e1fc68b83a3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QNMFrequencyKN", "::", "spin"}], ":", 
  " ", "\<\"Kerr-Newman quasinormal modes are only available for the coupled \
gravito-electromagnetic perturbations, |s| = 1 (electromagnetic-led) or |s| = \
2 (gravitational-led), but s=0 specified.\"\>"}]], "Message", "MSG",
 CellID->412879492,ExpressionUUID->"8f8541fc-b760-47f9-a948-6d636a898081"],

Cell[BoxData["$Failed"], "Output",
 CellLabel->"Out[1]=",
 CellID->1507170154,ExpressionUUID->"0db75420-03df-443d-aaf5-c3c730b84d06"]
}, Open  ]],

Cell["The black hole must be sub-extremal:", "ExampleText",
 CellID->1663853744,ExpressionUUID->"1f470961-99c8-4b94-aa8b-ef739b55fd2a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QNMFrequencyKN", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "0", ",", "0.8`", ",", 
   "0.6`"}], "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1488748577,ExpressionUUID->"b187e53a-1daf-4531-bc0b-08c771ed2af9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"QNMFrequencyKN", "::", "extremal"}], ":", 
  " ", "\<\"The spin a=0.8 and charge Q=0.6 must satisfy a^2 + Q^2 < 1 \
(sub-extremal black hole).\"\>"}]], "Message", "MSG",
 CellID->100745908,ExpressionUUID->"f6f787d1-f0e8-43b2-a0b4-f073b9e9ed23"],

Cell[BoxData["$Failed"], "Output",
 CellLabel->"Out[2]=",
 CellID->2021562958,ExpressionUUID->"4a9dfd08-7982-4b7e-961d-4df354ca49da"]
}, Open  ]],

Cell[TextData[{
 "Close to extremality machine-precision results are less accurate. At ",
 Cell[BoxData[
  RowBox[{"Q", "=", "0.999`"}]], "InlineFormula",ExpressionUUID->
  "2cb4f11b-2af6-4085-97dd-a4a042a0ddad"],
 " the machine-precision result differs from a 24-digit calculation by:"
}], "ExampleText",
 CellID->1004906255,ExpressionUUID->"36266559-ed4e-4635-b71b-5bdddb9bf6c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Abs", "[", 
  RowBox[{
   RowBox[{"QNMFrequencyKN", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "0", ",", "0", ",", "0", ",", 
     "0.999`"}], "]"}], "-", 
   RowBox[{"QNMFrequencyKN", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "0", ",", "0", ",", "0", ",", 
     "0.999`24."}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->352564144,ExpressionUUID->"17ff9a6b-8bd1-4bf8-b2f2-87b360f3b262"],

Cell[BoxData["2.0944118434615553`*^-10"], "Output",
 CellLabel->"Out[3]=",
 CellID->554292345,ExpressionUUID->"a09e81bd-63ab-4471-a7ee-133f7425eea3"]
}, Open  ]],

Cell[TextData[{
 "The 24-digit result agrees with a 40-digit calculation to about ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox["10", "24"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"61711316-f558-47ed-b298-8bfbff699e2c"],
 ", so this difference is the error of the machine-precision result."
}], "ExampleText",
 CellID->944034829,ExpressionUUID->"b6fc7d61-1131-4e56-8467-97af83ce917e"],

Cell[TextData[{
 "The continuation starts from the Kerr frequency computed with ",
 Cell[BoxData[
  ButtonBox["QNMFrequency",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequency"]], "InlineFormula",
  ExpressionUUID->"1ea8cc35-7b8d-40c0-b654-94bf74226f28"],
 ". For modes without tabulated Kerr data (",
 Cell[BoxData[
  RowBox[{"l", ">", "7"}]], "InlineFormula",ExpressionUUID->
  "0ed31552-94ba-466b-8bba-6e0896c92e97"],
 " or ",
 Cell[BoxData[
  RowBox[{"n", ">", "6"}]], "InlineFormula",ExpressionUUID->
  "3d8ded87-f8e1-4551-90e2-3875137d4f5d"],
 ") ",
 Cell[BoxData[
  ButtonBox["QNMFrequency",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequency"]], "InlineFormula",
  ExpressionUUID->"5d53e217-7123-46ab-bfd6-cf1911ef63dd"],
 " starts from asymptotic approximations, which can select a different mode. \
The Kerr frequency can then be given explicitly:"
}], "ExampleText",
 CellID->1286547469,ExpressionUUID->"6cbaaa46-d476-4555-83ba-ec72417b0be9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"QNMFrequencyKN", "[", 
  RowBox[{
   RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "1", ",", "0.6`", ",", "0.5`",
    ",", 
   RowBox[{"Method", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<HintzSeparated\>\"", ",", 
      RowBox[{"\"\<KerrFrequency\>\"", "\[Rule]", 
       RowBox[{"QNMFrequency", "[", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "1", ",", "0.6`"}], 
        "]"}]}]}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1463221945,ExpressionUUID->"a2ebbae3-67a3-4fe5-a0f8-9587014d265c"],

Cell[BoxData[
 RowBox[{"0.5247711009028088`", "\[VeryThinSpace]", "-", 
  RowBox[{"0.2454440496628923`", " ", "\[ImaginaryI]"}]}]], "Output",
 CellLabel->"Out[4]=",
 CellID->2043111857,ExpressionUUID->"ca47b65d-fd9f-4191-8ec7-6867d1db85fc"]
}, Open  ]],

Cell["\<\
The continuation follows the mode that is connected to the Kerr mode. \
Near-horizon (zero-damped) families of near-extremal black holes are not \
computed.\
\>", "ExampleText",
 CellID->1255513564,ExpressionUUID->"71145653-c561-4651-b0ed-1d6cf8cd8e2a"]
}, Open  ]],

