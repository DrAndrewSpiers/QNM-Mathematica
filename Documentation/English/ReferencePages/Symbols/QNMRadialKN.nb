Cell["\<\
In compactified hyperboloidal coordinates the domain is finite:\
\>", "ExampleText",
 CellID->1396457271,ExpressionUUID->"2f94bc58-4867-437a-87ca-cfa8f34af276"],

Cell[BoxData[
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"QNMRadialKN", "[", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "2", ",", "2", ",", "0", ",", "0.6`", ",", 
     "0.5`", ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<HintzSeparated\>\"", ",", 
        RowBox[{"\"\<Coordinates\>\"", 
         "\[Rule]", "\"\<CompactifiedHyperboloidal\>\""}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->2038614291,ExpressionUUID->"74563490-1c21-432d-8656-356da7659080"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ReImPlot", "[", 
  RowBox[{
   RowBox[{"S", "[", "\[Sigma]", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Sigma]", ",", "0", ",", 
     RowBox[{
      RowBox[{"S", "[", "\"\<Domain\>\"", "]"}], "\[LeftDoubleBracket]", "2", 
