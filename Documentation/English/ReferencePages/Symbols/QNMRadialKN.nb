Notebook[{

Cell[CellGroupData[{
Cell["QNMRadialKN", "ObjectName",
 CellID->2068061083,ExpressionUUID->"ca05dd6e-db60-4340-b36e-9141f380e0ad"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0136028f-f882-42f3-a256-533a997d1a8e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["QNMRadialKN",
    BaseStyle->"Link",
    ButtonData->"paclet:QNM/ref/QNMRadialKN"], "[", 
   RowBox[{
    StyleBox["s", "TI"], ",", 
    StyleBox["l", "TI"], ",", 
    StyleBox["m", "TI"], ",", 
    StyleBox["n", "TI"], ",", 
    StyleBox["a", "TI"], ",", 
    StyleBox["Q", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "f00e3890-1f59-4398-b843-453bcc5b6a67"],
 "\[LineSeparator]computes the radial function of a quasinormal mode of a \
Kerr-Newman black hole with spin a and charge Q."
}], "Usage",
 CellID->647798520,ExpressionUUID->"5bcc2b34-689b-4252-946c-f43c889f3e12"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["QNMRadialKN",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMRadialKN"]], "InlineFormula",ExpressionUUID->
  "88735aef-2b0e-4c95-8b68-6b179f49f2a8"],
 " produces a ",
 Cell[BoxData[
  ButtonBox["QNMRadialFunction",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMRadialFunction"]], "InlineFormula",
  ExpressionUUID->"ec5c014f-d941-4208-b5da-15386cd86b86"],
 " object, which represents a solution of the separated radial system of ",
 ButtonBox["P. Hintz, \"Perturbations of Kerr-Newman black holes: separation \
and mode stability\", arXiv:2609.33661 (2026)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2609.33661"], None},
  ButtonNote->"https://arxiv.org/abs/2609.33661"],
 ":"
}], "Notes",
 CellID->2008101628,ExpressionUUID->"79490557-bb54-4225-b73b-17840c462f7f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", 
      RowBox[{"w", "(", "r", ")"}]}], 
     RowBox[{"\[PartialD]", "r"}],
     MultilineFunction->None], "\[LongEqual]", 
    RowBox[{
     RowBox[{
      SubscriptBox["w", "\"\<\[Sharp]\>\""], "(", "r", ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["R", "1"], "(", "r", ")"}], "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[CurlyEpsilon]", " ", "\[Lambda]"}]}], 
      ")"}]}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5f193b3b-87f0-465f-9a40-962e04f7b57e"],
 ",   ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]", " ", 
      FractionBox[
       RowBox[{"\[PartialD]", 
        RowBox[{
         SubscriptBox["w", "\"\<\[Sharp]\>\""], "(", "r", ")"}]}], 
       RowBox[{"\[PartialD]", "r"}],
       MultilineFunction->None]}], "+", 
     RowBox[{
      RowBox[{
       SubscriptBox["w", "\"\<\[Sharp]\>\""], "(", "r", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"3", " ", "\[CurlyEpsilon]"}]}], ")"}], " ", 
         FractionBox[
          RowBox[{"\[PartialD]", "\[CapitalDelta]"}], 
          RowBox[{"\[PartialD]", "r"}],
          MultilineFunction->None]}], "+", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", 
         OverscriptBox["K", "~"]}]}], ")"}]}]}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"w", "(", "r", ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["R", "1"], "(", "r", ")"}], "-", 
       RowBox[{"\[ImaginaryI]", " ", "\[CurlyEpsilon]", " ", "\[Lambda]"}]}], 
      ")"}]}]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "447ce1d5-dd6a-4dd0-bcdf-c2de3b42d2f3"]
}], "Notes",
 CellID->543009921,ExpressionUUID->"6134d95c-9780-4d9a-abb4-c5a2da079055"],

Cell[TextData[{
 "with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", "\[LongEqual]", 
    RowBox[{
     SuperscriptBox["a", "2"], "+", 
     SuperscriptBox["Q", "2"], "+", 
     SuperscriptBox["r", "2"], "-", 
     RowBox[{"2", " ", "r"}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"02770b01-c57a-44c8-92f6-c1347d07af6b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"K", "\[LongEqual]", 
    RowBox[{
     RowBox[{"a", " ", "m"}], "-", 
     RowBox[{"\[Omega]", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["a", "2"], "+", 
        SuperscriptBox["r", "2"]}], ")"}]}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"23c8de5e-7301-43a6-bb01-7ab6f6956973"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Xi]", "0"], "\[LongEqual]", 
    FractionBox[
     RowBox[{"2", " ", 
      SuperscriptBox["Q", "2"], " ", "\[Omega]"}], 
     RowBox[{"1", "-", 
      SuperscriptBox["Q", "2"]}]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"203fd27b-36e6-4f87-8205-a553fd42527b"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["K", "~"], "\[LongEqual]", 
    RowBox[{"K", "-", 
     RowBox[{"\[CapitalDelta]", " ", 
      SubscriptBox["\[Xi]", "0"]}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"6bfd703e-7e0c-4a28-abdf-b01982ab73d8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "1"], "\[LongEqual]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"\[CurlyEpsilon]", " ", 
        RowBox[{"(", 
         RowBox[{"2", " ", "Q", " ", "\[Omega]", " ", 
          RowBox[{"(", 
           RowBox[{"r", "-", 
            SuperscriptBox["Q", "2"]}], ")"}]}], ")"}]}], 
       RowBox[{"1", "-", 
        SuperscriptBox["Q", "2"]}]]}], "+", 
     FractionBox[
      RowBox[{"3", " ", "\[ImaginaryI]"}], 
      RowBox[{"2", " ", "Q"}]]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"080b4ede-6106-4f41-bf6e-6971d754158f"],
 " (",
 Cell[BoxData[
  RowBox[{"M", "=", "1"}]], "InlineFormula",ExpressionUUID->
  "94243faa-89ce-4f29-98d5-1092e8360fff"],
 "). Here ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f11210ef-830a-4c68-85df-20c3db81b0c2"],
 " is Hintz's separation constant (the \"Eigenvalue\" key) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CurlyEpsilon]", "\[LongEqual]", 
    RowBox[{"\[PlusMinus]", "1"}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"02242762-d875-468f-8937-ae783e91ee35"],
 " labels the positive or negative spin system (the \"SpinSystem\" key)."
}], "Notes",
 CellID->1221601180,ExpressionUUID->"69a6a512-a01b-4c3c-9361-389595dc7851"],

Cell[TextData[{
 "The solution is that of the quasinormal mode computed with ",
 Cell[BoxData[
  ButtonBox["QNMFrequencyKN",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequencyKN"]], "InlineFormula",
  ExpressionUUID->"2033c1d0-00ab-48c6-a337-0006e57bf697"],
 ", with the same conventions for ",
 Cell[BoxData[
 "s"], "InlineFormula",ExpressionUUID->"4ba72a68-35b7-4e1c-9302-f340a9f283fb"],
 ", ",
 Cell[BoxData[
 "l"], "InlineFormula",ExpressionUUID->"ed5ad9e7-0376-4f79-9938-dac426cd10b1"],
 ", ",
 Cell[BoxData[
 "m"], "InlineFormula",ExpressionUUID->"03810d0a-36c2-4dc7-99c8-ebcf101aed48"],
 ", ",
 Cell[BoxData[
 "n"], "InlineFormula",ExpressionUUID->"f2e86528-1cf9-4cbf-b197-08e0eebf5292"],
 ", ",
 Cell[BoxData[
 "a"], "InlineFormula",ExpressionUUID->"480d1519-a8e1-436c-a94d-f7ceefa3f4b7"],
 " and ",
 Cell[BoxData[
 "Q"], "InlineFormula",ExpressionUUID->"490b4d88-1752-4000-b329-3cbde781349c"],
 ". It is smooth at the outer horizon ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "\"\<+\>\""], "\[LongEqual]", 
    RowBox[{
     SqrtBox[
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["a", "2"]}], "-", 
       SuperscriptBox["Q", "2"], "+", "1"}]], "+", "1"}]}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"5c0ad1b0-eb31-407f-a2f1-fba565ec5aac"],
 " and outgoing at infinity, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "\[Tilde]", 
    RowBox[{
     SuperscriptBox["r", "p"], " ", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "k", " ", "r"}], ")"}]}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ace07733-04df-4de4-8172-2b5b18ccd558"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "\[LongEqual]", 
    RowBox[{
     SubscriptBox["\[Xi]", "0"], "+", 
     RowBox[{"2", " ", "\[Omega]"}]}]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"ac8a6009-c2be-40ff-9991-503b32f0ff68"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "\[LongEqual]", 
    RowBox[{"4", " ", "\[ImaginaryI]", " ", "\[Omega]"}]}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"f771a46f-733a-4beb-9558-e7fbec1717f2"],
 " (the \"AsymptoticExponents\" key)."
}], "Notes",
 CellID->634065190,ExpressionUUID->"8b259f3a-80d5-4bed-bf4c-86379af2a739"],

Cell[TextData[{
 "The solution is normalised so that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"w", "(", 
     SubscriptBox["r", "\"\<+\>\""], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8c10da64-86be-44de-b7bc-18ecce2d61f6"],
 ". The \"Amplitudes\" key gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "\"\<\[ScriptCapitalH]\>\""], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9883a6cd-6a33-4bce-8bb9-336c75fce8bf"],
 " and the amplitude ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "\"\<\[ScriptCapitalI]\>\""], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"a8c82c5b-8afc-4a5c-b2be-d2348e5afd29"],
 " at infinity, defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "\[Tilde]", 
    RowBox[{
     SubscriptBox["w", "\"\<\[ScriptCapitalI]\>\""], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["r", 
        SubscriptBox["r", "\"\<+\>\""]], ")"}], "p"], " ", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "k", " ", 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "\"\<+\>\""]}], ")"}]}], ")"}]}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e5e41953-8e3c-4413-a8d7-eb3e18396325"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", "\[Infinity]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f3c2df67-bcd8-4710-8971-b4803af59ff0"],
 "."
}], "Notes",
 CellID->303256296,ExpressionUUID->"e5aa55a3-ca6b-4a7c-8365-979fbdefe1bb"],

Cell[TextData[{
 "By default the object represents ",
 Cell[BoxData[
  FormBox["w", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab923e11-cc45-4643-a515-98cf935676b6"],
 ". The other component is obtained with the suboption ",
 Cell[BoxData[
  RowBox[{"\"\<Component\>\"", "\[Rule]", "\"\<w\[Sharp]\>\""}]], 
  "InlineFormula",ExpressionUUID->"88f054da-9d0d-4645-ba12-9a273e3c8f05"],
 " or from an existing object ",
 Cell[BoxData[
 "qnm"], "InlineFormula",ExpressionUUID->
  "35c776ce-8701-4381-91ed-45892df64f37"],
 " as ",
 Cell[BoxData[
  RowBox[{"qnm", "[", "\"\<w\[Sharp]\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"ccdf22a3-914b-44e8-97e4-d4cdf93ab584"],
 " (and ",
 Cell[BoxData[
  RowBox[{"qnm", "[", "\"\<w\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "6e9b7d78-de62-4302-8813-02bd7c828564"],
 ")."
}], "Notes",
 CellID->627822280,ExpressionUUID->"58e1b32c-cd35-4962-9343-938d1acbd3e0"],

Cell[TextData[{
 "The suboption \"Coordinates\" can be \"BL\" (the default; ",
 Cell[BoxData[
  FormBox["w", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "70ae0705-91a6-4d14-8c95-139208679ae4"],
 " as a function of the Boyer-Lindquist radius ",
 Cell[BoxData[
 "r"], "InlineFormula",ExpressionUUID->"e8839d56-8299-4a2f-89d8-77f30234fb23"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "\"\<+\>\""], "\[LessEqual]", "r", "<", "\[Infinity]"}],
    TraditionalForm]], "InlineFormula",ExpressionUUID->
  "c3b6a619-b6e3-4962-98cd-496e0aa6a6e3"],
 "), \"Hyperboloidal\" (the rescaled function ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"H", "(", "r", ")"}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"w", "(", "r", ")"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["r", 
        SubscriptBox["r", "\"\<+\>\""]], ")"}], 
      RowBox[{"-", "p"}]], " ", 
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "\"\<+\>\""]}], ")"}]}], ")"}]}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "46fc135b-a4c0-4213-95d6-d780bf545775"],
 ", which is regular at the horizon and tends to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "\"\<\[ScriptCapitalI]\>\""], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"7b2f0178-354b-4845-af97-2ef07f12165b"],
 " at infinity) or \"CompactifiedHyperboloidal\" (",
 Cell[BoxData[
  FormBox["H", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7a76f077-2274-404a-892c-31b74c916d98"],
 " as a function of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "\[LongEqual]", 
    FractionBox["1", "r"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"87739533-3cd0-4c3a-8776-8893aa6aa5a5"],
 " on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "\[Sigma]", "\[LessEqual]", 
    FractionBox["1", 
     SubscriptBox["r", "\"\<+\>\""]]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f815a131-07bc-46cf-9488-ea04d50f9e15"],
 "). The same rescaling is applied to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "\"\<\[Sharp]\>\""], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"dac295ff-0ad5-4f5a-9e6e-1f50f95f2049"],
 "."
}], "Notes",
 CellID->1767383241,ExpressionUUID->"b6df735d-d01a-4b36-b30f-d0d033078184"],

Cell[TextData[{
 "The function is evaluated from four representations of one solution: the \
series about the horizon, the horizon solution integrated along the real axis \
to the matching radius (",
 Cell[BoxData[
  RowBox[{"r", "=", "6"}]], "InlineFormula",ExpressionUUID->
  "3dfcd362-80af-4f39-ab3f-85890c7a2787"],
 " by default), the outgoing solution continued outwards along the real axis, \
and an asymptotic series at large ",
 Cell[BoxData[
 "r"], "InlineFormula",ExpressionUUID->"76e7b0a7-f52d-4af9-9571-8bd0869123df"],
 ". Derivatives are computed exactly from the radial system (from the series \
near the horizon). With machine-precision input the values are typically \
accurate to about ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    SuperscriptBox["10", "12"]], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"09ae56a4-0c59-449e-8054-3563ead804d3"],
 "."
}], "Notes",
 CellID->1480360876,ExpressionUUID->"cbd1c51e-92c9-4d22-af08-7acb9eaad5ac"],

Cell[TextData[{
 "Hintz's radial variables are only defined for ",
 Cell[BoxData[
  RowBox[{"Q", "\[NotEqual]", "0"}]], "InlineFormula",ExpressionUUID->
  "f5b497a6-1184-4dc4-b235-9bc3eeb33c76"],
 ". Under ",
 Cell[BoxData[
  RowBox[{"Q", "\[Rule]", 
   RowBox[{"-", "Q"}]}]], "InlineFormula",ExpressionUUID->
  "2b4086a7-66c4-4a8c-aede-a01eaa09a5ae"],
 " the solution is mapped to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "Q"}], ",", 
     RowBox[{"-", "\[Lambda]"}], ",", "w", ",", 
     RowBox[{"-", 
      SubscriptBox["w", "\"\<\[Sharp]\>\""]}]}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"25f83977-030c-435d-91c5-3f9504955780"],
 "."
}], "Notes",
 CellID->694042865,ExpressionUUID->"2d34835a-2a0e-41db-a4ca-755931739a9d"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["QNMRadialKN",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMRadialKN"]], "InlineFormula",ExpressionUUID->
  "de9f6348-04a5-43c2-8f6b-bad60e1b834d"],
 " can be evaluated to arbitrary numerical precision."
}], "Notes",
 CellID->1216121578,ExpressionUUID->"83805185-947d-44f4-82f2-99e6e1397cea"],

Cell["The following options can be given: ", "Notes",
 CellID->1047885244,ExpressionUUID->"5634651a-28b5-472d-ad95-1e5f3f7141da"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "75e8ceae-d957-430a-9bb6-7ba333de73b2"], 
    ButtonBox["Method",
     BaseStyle->"Link"], 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
Method to use. The only method is \"HintzSeparated\" (the default).\
\>", "TableText",ExpressionUUID->"4075f666-6069-426a-93a1-ca86cccc8b55"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "b3d58db8-7261-4eea-b16c-b62a56c63616"], "\"\<Frequency\>\"", 
    ButtonBox["Automatic",
     BaseStyle->"Link"], Cell["\<\
frequency of the mode; by default it is computed with QNMFrequencyKN\
\>", "TableText",ExpressionUUID->"f2b7a45b-504d-459b-8ff4-c219abe2f3e6"]}
  }]], "3ColumnTableMod",
 CellID->1330518508,ExpressionUUID->"445c6de9-bc76-46d6-a26e-a9a7bb9ffac6"],

Cell[TextData[{
 "Suboptions can be given with ",
 Cell[BoxData[
  RowBox[{"Method", "\[Rule]", 
   RowBox[{"{", 
    RowBox[{"\"\<HintzSeparated\>\"", ",", "opts"}], "}"}]}]], 
  "InlineFormula",ExpressionUUID->"b4ae5ab4-d23d-47fa-8b1b-60f07803f4e7"],
 ". The suboptions of ",
 Cell[BoxData[
  ButtonBox["QNMFrequencyKN",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMFrequencyKN"]], "InlineFormula",
  ExpressionUUID->"d5f7de11-2018-4b00-b2f2-2eb358ac2aaa"],
 " are passed on to the computation of the frequency and the radial solution; \
in addition:"
}], "Notes",
 CellID->1418334518,ExpressionUUID->"2008b83d-bd5e-4bc1-ac54-115823162724"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c71fc815-761b-4914-89f4-898892a0a5fb"], "\"\<Coordinates\>\"", \
"\"\<BL\>\"", Cell[
    "\"BL\", \"Hyperboloidal\" or \"CompactifiedHyperboloidal\"", "TableText",
     ExpressionUUID->"0ddae3d5-43da-464f-8fd1-6e1fd9c7a598"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "4a22ab90-812a-4e3c-aadb-7a0aff13b0b7"], "\"\<Component\>\"", "\"\<w\>\"",
     Cell["\"w\" or \"w\[Sharp]\"", "TableText",ExpressionUUID->
     "4b53dfce-9bf4-4ef6-b330-033ad965ee77"]}
  }]], "3ColumnTableMod",
 CellID->1609270359,ExpressionUUID->"0652eb11-48ac-49e0-aee3-ebe4b20bfd68"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "See Also",
 Cell[BoxData[
  TemplateBox[{"SeeAlso", 
    Cell[
     BoxData[
      FrameBox[
       Cell[
       "Insert links to any related reference (function) pages.", 
        "MoreInfoText"], BaseStyle -> "IFrameBox"]], "MoreInfoTextOuter"]},
   "MoreInfoOpenerButtonTemplate"]],ExpressionUUID->
  "5c5b5ad5-54a2-441e-9eea-3460ef09f0fc"]
}], "SeeAlsoSection",
 CellID->1777181860,ExpressionUUID->"995e2eb2-1f33-4724-a681-b93241008b1c"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["QNMRadialFunction",
   BaseStyle->"Link",
