Cell[TextData[{
 "The solution satisfies Hintz's radial system; check the first equation at \
",
 Cell[BoxData[
  RowBox[{"r", "=", "4"}]], "InlineFormula",ExpressionUUID->
  "cdc4c4ca-f781-4eed-a8cd-53969028ff85"],
 ":"
}], "ExampleText",
 CellID->929924182,ExpressionUUID->"4223a3e9-fe4d-4f0c-8012-b135850b5c72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "=", "4"}], ",", 
     RowBox[{"\[Omega]", "=", 
      RowBox[{"R", "[", "\"\<\[Omega]\>\"", "]"}]}], ",", 
     RowBox[{"Q", "=", 
      RowBox[{"R", "[", "\"\<Q\>\"", "]"}]}], ",", 
     RowBox[{"\[Lambda]", "=", 
      RowBox[{"R", "[", "\"\<Eigenvalue\>\"", "]"}]}], ",", 
     RowBox[{"\[CurlyEpsilon]", "=", 
      RowBox[{"R", "[", "\"\<SpinSystem\>\"", "]"}]}]}], "}"}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["R", "\[Prime]",
      MultilineFunction->None], "[", "r", "]"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{
         "\[CurlyEpsilon]", " ", "2", " ", "\[Omega]", " ", "Q", " ", 
          RowBox[{"(", 
           RowBox[{"r", "-", 
            SuperscriptBox["Q", "2"]}], ")"}]}], 
         RowBox[{"1", "-", 
          SuperscriptBox["Q", "2"]}]]}], "+", 
       FractionBox[
        RowBox[{"3", " ", "\[ImaginaryI]"}], 
        RowBox[{"2", " ", "Q"}]], "+", 
       RowBox[{"\[ImaginaryI]", " ", "\[CurlyEpsilon]", " ", "\[Lambda]"}]}], 
      ")"}], " ", 
     RowBox[{
      RowBox[{"R", "[", "\"\<w\[Sharp]\>\"", "]"}], "[", "r", "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:=",
 CellID->1340019463,ExpressionUUID->"553cfa02-317f-4ed7-bed8-3e24b97d9c4c"],

Cell[BoxData[
 RowBox[{"8.881784197001252`*^-16", "+", 
  RowBox[{"0.`", " ", "\[ImaginaryI]"}]}]], "Output",
 CellLabel->"Out[2]=",
 CellID->930273523,ExpressionUUID->"30b8b1fd-f93f-4fad-ac81-00f39f5a7bb4"]
}, Open  ]],

Cell[TextData[{
 "At large ",
 Cell[BoxData[
 "r"], "InlineFormula",ExpressionUUID->"a8ec249f-8695-42da-acc7-3a55e684e9e4"],
 " the solution approaches ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "\"\<\[ScriptCapitalI]\>\""], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["r", 
       SubscriptBox["r", "\"\<+\>\""]], ")"}], "p"], " ", 
    RowBox[{"exp", "(", 
     RowBox[{"\[ImaginaryI]", " ", "k", " ", 
      RowBox[{"(", 
       RowBox[{"r", "-", 
        SubscriptBox["r", "\"\<+\>\""]}], ")"}]}], ")"}]}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"cec93fc3-8974-4c22-9f22-cc5ef8b29194"],
 ", with corrections of order ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "r"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "00742c93-9562-41c0-86ba-0f029a424979"],
 ":"
}], "ExampleText",
 CellID->1606798959,ExpressionUUID->"a6466fd1-8d88-4741-b135-d663cf3f4105"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"k", "=", 
      RowBox[{
       RowBox[{"R", "[", "\"\<AsymptoticExponents\>\"", "]"}], 
       "[", "\"\<k\>\"", "]"}]}], ",", 
     RowBox[{"p", "=", 
      RowBox[{
       RowBox[{"R", "[", "\"\<AsymptoticExponents\>\"", "]"}], 
       "[", "\"\<p\>\"", "]"}]}], ",", 
     RowBox[{"rp", "=", 
      RowBox[{
       RowBox[{"R", "[", "\"\<Domain\>\"", "]"}], "\[LeftDoubleBracket]", "1",
        "\[RightDoubleBracket]"}]}], ",", 
     RowBox[{"wI", "=", 
      RowBox[{
       RowBox[{"R", "[", "\"\<Amplitudes\>\"", "]"}], 
       "[", "\"\<\[ScriptCapitalI]\>\"", "]"}]}]}], "}"}], ",", 
   RowBox[{"Table", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"R", "[", "r", "]"}], 
      RowBox[{"wI", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"\[ImaginaryI]", " ", "k", " ", 
         RowBox[{"(", 
          RowBox[{"r", "-", "rp"}], ")"}]}], "]"}], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["r", "rp"], ")"}], "p"]}]], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["10.`", "2"], ",", 
         SuperscriptBox["10.`", "4"], ",", 
         SuperscriptBox["10.`", "6"]}], "}"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[3]:=",
 CellID->1316149818,ExpressionUUID->"b819fcbe-c198-4005-b0b0-af4989c33d28"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"0.963467068721799`", "\[VeryThinSpace]", "-", 
    RowBox[{"0.10814347337791747`", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{
   "0.99966624551195096351227339611268400623`15.34003822534451", "-", 
    RowBox[{
    "0.00113680957731407920640704374573092752`12.622418501826223", " ", 
     "\[ImaginaryI]"}]}], ",", 
   RowBox[{"0.99999666592690826133921604360310331123`15.347599049286021", "-", 
    RowBox[{
    "0.00001137375135418817963663185855932012`10.4105796731419", " ", 
     "\[ImaginaryI]"}]}]}], "}"}]], "Output",
 CellLabel->"Out[3]=",
 CellID->699122195,ExpressionUUID->"451d8966-ae1b-48c1-a016-95d97e422896"]
}, Open  ]],

