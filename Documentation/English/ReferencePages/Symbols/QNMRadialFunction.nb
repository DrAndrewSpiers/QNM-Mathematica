Notebook[{

Cell[CellGroupData[{
Cell["QNMRadialFunction", "ObjectName",
 CellID->1001654648,ExpressionUUID->"528189f5-69d0-4707-ba76-4864c121a591"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b2812b0c-b622-432f-b8f5-b1692204c360"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["QNMRadialFunction",
    BaseStyle->"Link",
    ButtonData->"paclet:QNM/ref/QNMRadialFunction"], "[", "...", "]"}]], 
  "InlineFormula",ExpressionUUID->"1153ff06-0d54-4e84-969a-794ef5ac3a8e"],
 "\[LineSeparator]is an object representing a quasinormal mode solution to \
the radial Teukolsky equation (from ",
 Cell[BoxData[
  ButtonBox["QNMRadial",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMRadial"]], "InlineFormula",ExpressionUUID->
  "1cf31ba3-08b6-4ce0-9b87-d141fad901fe"],
 ") or to Hintz's separated radial system for Kerr-Newman black holes (from \
",
 Cell[BoxData[
  ButtonBox["QNMRadialKN",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMRadialKN"]], "InlineFormula",ExpressionUUID->
  "f15cfbe6-b3f7-4efa-946a-2b90238cba16"],
 ")."
}], "Usage",
 CellID->1738734287,ExpressionUUID->"b38fbe74-e2e9-44dd-a12b-bc132a071fcd"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"qnm", "[", "r", "]"}]], "InlineFormula",ExpressionUUID->
  "cb1ce197-a321-4bad-a768-d0082ea506cb"],
 " evaluates the radial function at the point ",
 Cell[BoxData[
 "r"], "InlineFormula",ExpressionUUID->"67fc36bd-915b-4af9-ab73-fe6bd8fea4f9"],
 " (or at a list of points). Derivatives are obtained with ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["qnm", "\[Prime]",
    MultilineFunction->None], "[", "r", "]"}]], "InlineFormula",
  ExpressionUUID->"0626bca0-e072-422f-98f2-651a04776565"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["qnm", 
    TagBox[
     RowBox[{"(", "k", ")"}],
     Derivative],
    MultilineFunction->None], "[", "r", "]"}]], "InlineFormula",
  ExpressionUUID->"1d832d67-7943-43a7-b145-83f2161517eb"],
 ". Outside the domain given by ",
 Cell[BoxData[
  RowBox[{"qnm", "[", "\"\<Domain\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"677a100c-0d69-4c65-965f-982f5e61d5c7"],
 " a message is issued and ",
 ButtonBox["Indeterminate",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Indeterminate"],
 " is returned."
}], "Notes",
 CellID->1927993142,ExpressionUUID->"d6a5edb3-a8b8-4df0-892b-c76002b37d16"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"qnm", "[", "\"\<key\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "9e64da1b-de11-4f4f-9c4a-9bfe6694e4f5"],
 " gives a property of the solution, and ",
 Cell[BoxData[
  RowBox[{"Keys", "[", "qnm", "]"}]], "InlineFormula",ExpressionUUID->
  "8229179b-38bc-4088-8274-a020f9ddbbfa"],
 " lists the available keys."
}], "Notes",
 CellID->1151272503,ExpressionUUID->"f44a4fed-5ed3-401f-a0e5-4cfb966c3cb9"],

Cell[TextData[{
 "Objects from ",
 Cell[BoxData[
  ButtonBox["QNMRadial",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMRadial"]], "InlineFormula",ExpressionUUID->
  "760d59b9-a317-46f8-ab61-0947ecb2d676"],
 " have the keys \"s\", \"l\", \"m\", \"n\", \"a\", \"\[Omega]\" (the \
frequency), \"Eigenvalue\" (the spin-weighted spheroidal eigenvalue), \
\"Method\", \"Amplitudes\", \"Coordinates\" and \"Domain\"."
}], "Notes",
 CellID->1603604941,ExpressionUUID->"df957dff-999b-431f-a052-2a53f7ab37b6"],

Cell[TextData[{
 "Objects from ",
 Cell[BoxData[
  ButtonBox["QNMRadialKN",
   BaseStyle->"Link",
   ButtonData->"paclet:QNM/ref/QNMRadialKN"]], "InlineFormula",ExpressionUUID->
  "29b427c7-c229-4165-9016-36f5a5685944"],
 " represent a component of the solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"w", ",", 
     SubscriptBox["w", "\"\<\[Sharp]\>\""]}], "}"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2404e867-75a2-45b8-8e8e-55d461b94ee8"],
 " of the radial system of ",
 ButtonBox["P. Hintz, \"Perturbations of Kerr-Newman black holes: separation \
and mode stability\", arXiv:2609.33661 (2026)",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2609.33661"], None},
  ButtonNote->"https://arxiv.org/abs/2609.33661"],
 ". In addition to the keys above (with \"Eigenvalue\" Hintz's separation \
constant ",
 Cell[BoxData[
  FormBox["\[Lambda]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f21d786f-39d1-430d-a3da-f8a5569efbcf"],
 "), they have the keys \"Q\" (the charge), \"Family\" (\"gravitational-led\" \
or \"electromagnetic-led\"), \"SpinSystem\", \"Component\" (\"w\" or \"w\
\[Sharp]\") and \"AsymptoticExponents\" (",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8947c4a8-2055-46fa-99d6-8b5ecca84387"],
 " and ",
 Cell[BoxData[
  FormBox["p", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "cad80da1-9c6c-4317-9e34-5d2c7b27a4db"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "\[Tilde]", 
    RowBox[{
     SuperscriptBox["r", "p"], " ", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "k", " ", "r"}], ")"}]}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5afed046-b688-434e-b713-975f852da43b"],
 "). For these objects ",
 Cell[BoxData[
  RowBox[{"qnm", "[", "\"\<w\>\"", "]"}]], "InlineFormula",ExpressionUUID->
  "5981a642-5914-4e59-b12b-c3f3e90322a8"],
 " and ",
 Cell[BoxData[
  RowBox[{"qnm", "[", "\"\<w\[Sharp]\>\"", "]"}]], "InlineFormula",
  ExpressionUUID->"c22f1dd2-2399-4f8c-a4a3-bdccc0b07835"],
 " give the object for the respective component."
}], "Notes",
 CellID->1443815411,ExpressionUUID->"b5ea4b53-ce33-4917-8b82-419aa8cafa1a"],

Cell[TextData[{
 "For Kerr-Newman objects the \"Amplitudes\" are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["w", "\"\<\[ScriptCapitalH]\>\""], "\[LongEqual]", 
    RowBox[{"w", "(", 
     SubscriptBox["r", "\"\<+\>\""], ")"}], "\[LongEqual]", "1"}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8bd4e013-a746-45fe-b286-5c1a86c0737f"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "\"\<\[ScriptCapitalI]\>\""], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"af3849d6-27d5-4185-af81-050cc0c4a415"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"w", "\[Tilde]", 
    RowBox[{
     SubscriptBox["w", "\"\<\[ScriptCapitalI]\>\""], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["r", 
        SubscriptBox["r", "\"\<+\>\""]], ")"}], "p"], " ", 
     RowBox[{"exp", "(", 
      RowBox[{"\[ImaginaryI]", " ", "k", " ", 
       RowBox[{"(", 
        RowBox[{"r", "-", 
         SubscriptBox["r", "\"\<+\>\""]}], ")"}]}], ")"}]}]}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "af5872a9-0897-456b-acd3-a40e8363e385"],
 " as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "\[Rule]", "\[Infinity]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"b199ad68-cf29-41e2-8c6e-ec304641a075"],
 "."
}], "Notes",
 CellID->1957712592,ExpressionUUID->"53e0aadf-104b-40fb-90d1-7c2766b5feab"]
}, Open  ]],

